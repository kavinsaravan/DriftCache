# API authentication
REQUIRE_API_KEY=true
API_KEY=replace_with_a_random_secret
METRICS_API_KEY=replace_with_a_read_only_secret

# PostgreSQL Configuration
DATABASE_URL=postgresql://driftcache:driftcache_password@localhost:5432/driftcache
POSTGRES_USER=driftcache
POSTGRES_PASSWORD=driftcache_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=driftcache

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gpt-4o-mini

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
VECTOR_INDEX_TYPE=FLAT

# Semantic Cache Settings
SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=3600
VECTOR_CLEANUP_INTERVAL_SECONDS=3600

# Browser origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
